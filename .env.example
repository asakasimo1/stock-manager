# 한국투자증권 KIS Developers API 키
# https://apiportal.koreainvestment.com/ 에서 발급

KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=12345678-01        # 계좌번호 (XXXXXXXX-XX 형식)

# 모드 설정: true = 모의투자, false = 실계좌
PAPER_TRADE=true

# 매매 전략 선택 (trader.py 재시작 시 적용)
#   optimized  : 기본 최적 전략 (백테스트 +96%, 낙폭 -27.5%)
#   war_risk   : 전쟁/지정학 리스크 장기화 — 빠른 손절, 단기 보유, 소액 주문
#   hold       : 버티기 — 전쟁 종전·반등 기대, 익절폭 20%, 20일 보유
#   defensive  : 방어형 — 강한 신호만, 손절 -3%, 최대 2종목
#   aggressive : 공격형 — 손절 여유 -7%, 익절 15%, 15일 보유
STRATEGY=optimized

# Supabase (GitHub Actions 배포 시 필요)
# https://supabase.com → 프로젝트 → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your_service_role_key_here

# GitHub Gist — stock_analyzer 대시보드 '거래 내역' 연동
# stock_analyzer와 동일한 GIST_ID 사용
# GH_TOKEN: GitHub Settings → Developer settings → Personal access tokens → gist 권한
GIST_ID=your_gist_id_here
GH_TOKEN=your_github_token_here
